{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "noEmit": true,
    "declaration": false,
    "types": ["vite/client", "vite-plugin-pwa/preact", "node"],
    "paths": {
      "@viet/core": ["../../packages/core/src/index.ts"],
      "@viet/content": ["../../packages/content/src/index.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"]
}
