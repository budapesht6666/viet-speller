# Скопировать в .env. Сам .env в git не попадает.

# SQLite. Локально — apps/api/data/, в контейнере — /app/data/
# (по vps-ops это /srv/apps/viet-speller/data, он в ночном бэкапе).
DATABASE_URL="file:./data/dev.db"

# Собранный фронтенд, который раздаёт Nest.
WEB_DIST="../web/dist"

PORT=3000

# Подпись сессий. Длинная случайная строка, своя на каждом сервере:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="заменить"

# ИИ-собеседник (PLAN.md, этап 11) — только бесплатные тарифы. Нет ни
# одного ключа — разговор показывает «собеседник не настроен», остальное
# работает. Порядок: сначала Gemini, при лимите — Groq.
#   aistudio.google.com/apikey · console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
