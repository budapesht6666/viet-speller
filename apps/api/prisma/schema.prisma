// Схема базы Viet Speller. SQLite — файл в data/ (по vps-ops он попадает
// в ночной бэкап). Прогресс хранится журналом событий: состояние — карточки,
// серия, минуты — сервер вычисляет из него тем же кодом, что телефон
// (packages/core/src/progress.ts), и не хранит.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Family {
  id         String   @id @default(uuid())
  name       String
  /// Код-приглашение: по нему остальные входят в семью.
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  members    User[]
}

model User {
  id           String   @id @default(uuid())
  /// Логин для входа — в нижнем регистре.
  login        String   @unique
  /// Как показывать в семейном рейтинге.
  name         String
  /// argon2id.
  passwordHash String
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id])
  createdAt    DateTime @default(now())
  events       Event[]
  speech       SpeechAttempt[]
  avatar       Avatar?
}

model Event {
  /// Порядок приёма на сервере — курсор синхронизации: «дай всё после seq».
  seq        Int      @id @default(autoincrement())
  /// UUID, выданный телефоном. Повторная отправка того же события ничего не удваивает.
  id         String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String
  /// Время события на телефоне.
  at         DateTime
  seconds    Int
  /// Остальные поля события как JSON: схема события живёт в packages/core.
  payload    String
  receivedAt DateTime @default(now())

  @@index([userId, seq])
}

/// Попытка сказать в уроке: что услышал движок распознавания. Не прогресс,
/// а диагностика — из неё отчёт отвечает, пишет ли движок тон и слышит ли
/// слог (packages/core/src/speech.ts). Хранится сырой: правило поменяется —
/// отчёт пересчитается.
model SpeechAttempt {
  /// UUID, выданный телефоном. Повторная отправка ничего не удваивает.
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  /// Время попытки на телефоне.
  at         DateTime
  itemId     String
  /// Что вернул движок. Пусто — не вернул ничего.
  heard      String
  /// apple | google | other — движки отвечают по-разному.
  engine     String
  receivedAt DateTime @default(now())
}

/// Фото профиля. Отдельной таблицей: картинка весит килобайты, а строку
/// пользователя читает каждый запрос. Телефон присылает уже уменьшенную.
model Avatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id])
  image     Bytes
  /// MIME-тип картинки: image/jpeg, image/png или image/webp.
  type      String
  /// Входит в адрес картинки: новое фото — новый адрес, старое не залипает в кеше.
  updatedAt DateTime @updatedAt
}
